# Contoh konfigurasi environment variables.
# Salin file ini menjadi .env lalu isi nilainya.
# Catatan: semua variabel berawalan VITE_ akan ikut ter-bundle ke browser,
# jadi JANGAN pernah menaruh password / API key rahasia di sini.

VITE_APP_NAME="Daftar Tugas Kuliah"
VITE_APP_VERSION="1.0.0"
VITE_DESCRIPTION="Aplikasi daftar tugas kuliah mahasiswa Teknik Informatika"
